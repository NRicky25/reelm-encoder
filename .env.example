# Cloudflare R2 — dashboard > R2 > Manage API tokens ("Object Read & Write", this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reelm-videos
# The bucket's public address: the r2.dev "Public Development URL" for testing,
# or your custom domain in production (e.g. https://media.reelm.tv)
R2_PUBLIC_URL=

# Only needed if ffmpeg isn't found automatically
# FFMPEG_DIR=C:\path\to\ffmpeg\bin
