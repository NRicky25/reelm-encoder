# Everything here is optional. Copy to .env to use it.

# Where you host the uploaded video folders: the R2 "Public Development URL" for
# testing, or your custom domain (e.g. https://media.reelm.tv). Only used to show
# each video's full link, ready to copy into the Reelm admin.
PUBLIC_URL=

# Only needed if ffmpeg isn't found automatically
# FFMPEG_DIR=C:\path\to\ffmpeg\bin
